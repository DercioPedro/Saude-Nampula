{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home.html", "destination": "/", "permanent": true },
    { "source": "/hospital.html", "destination": "/hospital", "permanent": true },
    { "source": "/centros.html", "destination": "/centros", "permanent": true },
    { "source": "/farm.html", "destination": "/farm", "permanent": true },
    { "source": "/emer.html", "destination": "/emer", "permanent": true },
    { "source": "/sobre.html", "destination": "/sobre", "permanent": true },
    { "source": "/dicas.html", "destination": "/dicas", "permanent": true },
    { "source": "/info.html", "destination": "/info", "permanent": true },
    { "source": "/admin-login.html", "destination": "/admin-login", "permanent": true },
    { "source": "/admin-panel.html", "destination": "/admin-panel", "permanent": true },
    { "source": "/admin-produtos.html", "destination": "/admin-produtos", "permanent": true },
    { "source": "/login-farmacia.html", "destination": "/login-farmacia", "permanent": true },
    { "source": "/medicamentos.html", "destination": "/medicamentos", "permanent": true },
    { "source": "/detalhes-farmacia.html", "destination": "/detalhes-farmacia", "permanent": true },
    { "source": "/centros-detalhes.html", "destination": "/centros-detalhes", "permanent": true },
    { "source": "/hospital-detalhes.html", "destination": "/hospital-detalhes", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/home.html" },
    { "source": "/hospital", "destination": "/hospital.html" },
    { "source": "/centros", "destination": "/centros.html" },
    { "source": "/farm", "destination": "/farm.html" },
    { "source": "/emer", "destination": "/emer.html" },
    { "source": "/sobre", "destination": "/sobre.html" },
    { "source": "/dicas", "destination": "/dicas.html" },
    { "source": "/info", "destination": "/info.html" },
    { "source": "/admin-login", "destination": "/admin-login.html" },
    { "source": "/admin-panel", "destination": "/admin-panel.html" },
    { "source": "/admin-produtos", "destination": "/admin-produtos.html" },
    { "source": "/login-farmacia", "destination": "/login-farmacia.html" },
    { "source": "/medicamentos", "destination": "/medicamentos.html" },
    { "source": "/detalhes-farmacia", "destination": "/detalhes-farmacia.html" },
    { "source": "/centros-detalhes", "destination": "/centros-detalhes.html" },
    { "source": "/hospital-detalhes", "destination": "/hospital-detalhes.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/admin-login",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin-panel",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin-produtos",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/login-farmacia",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/hospital-detalhes",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/centros-detalhes",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/detalhes-farmacia",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/medicamentos",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/styles/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/JS/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    }
  ]
}
