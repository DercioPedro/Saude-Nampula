{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/home" },
    { "source": "/hospital", "destination": "/hospital" },
    { "source": "/centros", "destination": "/centros" },
    { "source": "/farm", "destination": "/farm" },
    { "source": "/emer", "destination": "/emer" },
    { "source": "/sobre", "destination": "/sobre" },
    { "source": "/dicas", "destination": "/dicas" },
    { "source": "/info", "destination": "/info" },
    { "source": "/admin-login", "destination": "/admin-login" },
    { "source": "/admin-panel", "destination": "/admin-panel" },
    { "source": "/admin-produtos", "destination": "/admin-produtos" },
    { "source": "/login-farmacia", "destination": "/login-farmacia" },
    { "source": "/medicamentos", "destination": "/medicamentos" },
    { "source": "/detalhes-farmacia", "destination": "/detalhes-farmacia" },
    { "source": "/centros-detalhes", "destination": "/centros-detalhes" },
    { "source": "/hospital-detalhes", "destination": "/hospital-detalhes" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
